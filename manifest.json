{
  "name": "VEO Automation - Auto VEO & Nano Banana on Google Flow",
  "description": "Auto VEO & Nano Banana your prompts at scale. Batch generate and auto-download videos and images on Google Flow.",
  "version": "3.0.2.0",
  "version_name": "3.0.2",
  "manifest_version": 3,
  "action": {
    "default_title": "VEO Automation - Auto VEO & Nano Banana on Google Flow"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["assets/index.ts-B0-QdwYi.js"],
      "all_frames": false,
      "matches": ["*://labs.google/*", "*://flow.google.com/*"],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "src/ui/side-panel/index.html"
  },
  "offline_enabled": true,
  "host_permissions": [
    "*://labs.google/*",
    "*://flow.google.com/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "background",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger",
    "cookies"
  ],
  "web_accessible_resources": [
    {
      "matches": ["*://labs.google/*", "*://flow.google.com/*"],
      "resources": ["assets/index.ts-B0-QdwYi.js"],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/logo.png",
    "24": "src/assets/logo.png",
    "32": "src/assets/logo.png",
    "128": "src/assets/logo.png"
  }
}